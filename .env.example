# ===== App =====
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
# Comma-separated list of valid API keys. Client sends `X-API-Key: <key>`.
API_KEYS=changeme-dev-key
# Restrict the subset of allowed PPT Master routes (create, edit, template, postprocess)
ALLOWED_ROUTES=create,edit,template,postprocess
# Hard caps to protect the worker
MAX_CONCURRENT_JOBS=2
MAX_JOB_TIMEOUT_SECONDS=1800
MAX_SOURCE_SIZE_MB=50

# ===== Storage =====
# local | s3
STORAGE_BACKEND=local
# Local backend
STORAGE_LOCAL_ROOT=./data
# S3 backend (boto3 reads AWS_ACCESS_KEY_ID etc. from env too)
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=pptmaster/
STORAGE_S3_REGION=us-east-1

# ===== PPT Master =====
# Where the hugohe3/ppt-master repo will be cloned/located
PPTMASTER_REPO_DIR=./.ppt-master
PPTMASTER_REPO_URL=https://github.com/hugohe3/ppt-master.git
PPTMASTER_REPO_BRANCH=main
# If true, on startup the service clones the repo and installs its requirements.txt
PPTMASTER_AUTO_SETUP=true

# ===== LLM (set the provider(s) you actually use) =====
# Active provider: openai | anthropic | gemini | kimi | azure | custom
LLM_PROVIDER=azure
# Default model per provider (override if you wish)
LLM_MODEL_OPENAI=
LLM_MODEL_ANTHROPIC=
LLM_MODEL_GEMINI=
LLM_MODEL_KIMI=
# For Azure, this is the deployment name (not the base model name)
LLM_MODEL_AZURE=
# API keys (leave blank to disable a provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
AZURE_API_KEY=
# Azure OpenAI endpoint, e.g. https://my-resource.openai.azure.com/
AZURE_ENDPOINT=
# Azure OpenAI API version, e.g. 2024-02-15-preview
AZURE_API_VERSION=2024-02-15-preview
# API version for the Responses endpoint (needed for gpt-6 tool calling).
AZURE_RESPONSES_API_VERSION=2025-04-01-preview
# OpenAI-compatible base URL (used for Kimi or other OpenAI-compatible providers)
OPENAI_BASE_URL=
KIMI_BASE_URL=
# Generic "custom" provider: any OpenAI-compatible chat completions endpoint
# (Groq, OpenRouter, Together, vLLM, Ollama, LM Studio, DeepSeek...).
# Requires CUSTOM_BASE_URL + LLM_MODEL_CUSTOM; CUSTOM_API_KEY optional for
# local endpoints without auth. CUSTOM_LABEL renames it in the web UI.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
LLM_MODEL_CUSTOM=
CUSTOM_LABEL=
# Sampling
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=8192
# Agent loop safety
LLM_MAX_ITERATIONS=100

# ===== MCP server =====
# Expose the service as MCP tools over streamable HTTP at MCP_PATH.
# Requests must carry the same X-API-Key as the REST API.
MCP_ENABLED=true
MCP_PATH=/mcp
# Comma-separated Host values allowed to reach the MCP endpoint (anti
# DNS-rebinding). Leave empty when serving behind a proxy/domain.
MCP_ALLOWED_HOSTS=

# ===== Image generation =====
# Active backend for the agent's `generate_image` tool: openai | azure | gemini | qwen
IMAGE_BACKEND=openai
IMAGE_CONCURRENCY=3
# Default output size passed to the backend
IMAGE_SIZE=1024x1024
# Per-backend model / deployment names
IMAGE_MODEL_OPENAI=gpt-image-1
# For Azure, this is the deployment name of the image model (required; no fallback).
# Azure also needs AZURE_ENDPOINT and AZURE_API_VERSION (set in the LLM section above).
IMAGE_MODEL_AZURE=
IMAGE_MODEL_GEMINI=imagen-3.0-generate-002
IMAGE_MODEL_QWEN=qwen-image
# Qwen / DashScope ([OI]-compatible) image endpoint
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional stock-photo search
PIXABAY_API_KEY=

# ===== Webhooks (optional) =====
# Default webhook URL to dispatch job events to (per-job override supported)
WEBHOOK_DEFAULT_URL=
WEBHOOK_SECRET=
